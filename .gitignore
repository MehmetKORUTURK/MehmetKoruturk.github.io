# Whitelist approach: ignore everything by default,
# only track files required for the live GitHub Pages site.

# Ignore everything at root
/*

# Allow only these files / dirs at root
!/.gitignore
!/.nojekyll
!/index.html
!/404.html
!/style.css
!/script.js
!/robots.txt
!/README.md
!/MehmetKoruturk_CV.pdf
!/assets/

# Inside assets/, ignore everything except the profile photo
assets/*
!assets/profile.jpg
